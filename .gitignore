node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.DS_Store
.env
.env.local
playwright-report/
test-results/
artifacts/screenshots/*.png
!artifacts/screenshots/.gitkeep
# The art director's contact sheet. Regenerated by `--project=gallery` on
# demand and reviewed in the moment, not a build output worth versioning.
artifacts/gallery/*.png
dist-types/

# Declaration output must never land in a source tree. A stray `tsc` without
# an `outDir` drops 150 of these into `services/api/src` and they are then one
# careless `git add -A` away from being committed.
**/src/**/*.d.ts
**/src/**/*.d.ts.map
**/src/**/*.js
**/src/**/*.js.map

# Generated verification reports. The screenshots the visual suite compares
# against are baselines and stay tracked; everything a tool writes does not.
artifacts/**/*.json
artifacts/**/*.md
!e2e/__screenshots__/**
artifacts/font/

# Offline audio renders, written by `npm run audio:soundscape`.
#
# ADR-0002 says no audio assets — nothing here is one. These are *outputs*: the
# engine's own synthesis, captured so a person can eventually put headphones on
# and answer the questions no measurement can. They are regenerated from source
# in a couple of minutes and a thirty-second stereo WAV is 1.4 MB, so they are
# looked at and thrown away, never versioned.
artifacts/audio/*.wav
artifacts/audio/*.png

# Agent worktrees, created by isolation runs.
.claude/worktrees/

# Grading sets: captures, not sources.
artifacts/grade/
artifacts/sunset/
artifacts/audio/
artifacts/bite/
artifacts/ground-coverage.png
