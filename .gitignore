node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.DS_Store
.env
.env.local
playwright-report/
test-results/
artifacts/screenshots/*.png
!artifacts/screenshots/.gitkeep
# The art director's contact sheet. Regenerated by `--project=gallery` on
# demand and reviewed in the moment, not a build output worth versioning.
artifacts/gallery/*.png
dist-types/

# Declaration output must never land in a source tree. A stray `tsc` without
# an `outDir` drops 150 of these into `services/api/src` and they are then one
# careless `git add -A` away from being committed.
**/src/**/*.d.ts
**/src/**/*.d.ts.map
**/src/**/*.js
**/src/**/*.js.map

# Generated verification reports. The screenshots the visual suite compares
# against are baselines and stay tracked; everything a tool writes does not.
artifacts/**/*.json
artifacts/**/*.md
!e2e/__screenshots__/**
